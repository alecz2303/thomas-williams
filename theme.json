{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "layout": {
            "contentSize": "1200px",
            "wideSize": "1440px"
        },
        "spacing": {
            "units": [
                "px",
                "rem",
                "%",
                "vw",
                "vh"
            ]
        },
        "typography": {
            "fluid": true
        },
        "color": {
            "custom": true,
            "customGradient": false,
            "defaultGradients": false
        }
    },
    "styles": {
        "spacing": {
            "blockGap": "0"
        }
    }
}